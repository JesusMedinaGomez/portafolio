    <script id="suite-data" type="application/json" set:html={suiteJSON}></script>

    <script>
      const glow = document.querySelector<HTMLElement>(".cursor-glow");
      const hero = document.querySelector<HTMLElement>(".hero");
      const orb = document.querySelector<HTMLElement>(".hero-orb");

      if (window.matchMedia("(pointer: fine) and (prefers-reduced-motion: no-preference)").matches) {
        window.addEventListener("pointermove", (event) => {
          if (glow) {
            glow.style.left = `${event.clientX}px`;
            glow.style.top = `${event.clientY}px`;
          }
          if (hero && orb) {
            const bounds = hero.getBoundingClientRect();
            const x = (event.clientX - bounds.left) / bounds.width - 0.5;
            const y = (event.clientY - bounds.top) / bounds.height - 0.5;
            orb.style.transform = `translate(${x * 35}px, ${y * 35}px)`;
          }
        }, { passive: true });
      }

      const revealElements = document.querySelectorAll(".reveal");
      if ("IntersectionObserver" in window) {
        const observer = new IntersectionObserver((entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add("visible");
              observer.unobserve(entry.target);
            }
          }
        }, { threshold: 0.08 });
        revealElements.forEach((element) => observer.observe(element));
      } else {
        revealElements.forEach((element) => element.classList.add("visible"));
      }

      // La miniatura de máxima resolución no existe en todos los videos.
      // Si YouTube devuelve su imagen de sustitución (120 px), intentamos
      // una alternativa más pequeña, evitando mostrar una miniatura rota.
      const qualities = ["maxresdefault", "sddefault", "hqdefault", "mqdefault", "default"];
      document.querySelectorAll<HTMLImageElement>("img[data-youtube-id]").forEach((img) => {
        const id = img.dataset.youtubeId;
        if (!id) return;
        let index = 0;
        const tryNext = () => {
          index++;
          if (index < qualities.length) {
            img.src = `https://i.ytimg.com/vi/${encodeURIComponent(id)}/${qualities[index]}.jpg`;
          }
        };
        img.addEventListener("error", tryNext);
        img.addEventListener("load", () => {
          // YouTube a veces devuelve una imagen de 120x90 en vez de un 404.
          if (img.naturalWidth <= 120 && index < qualities.length - 1) tryNext();
        });
        if (img.complete && img.naturalWidth > 0 && img.naturalWidth <= 120) tryNext();
      });

      // MESA DE MONTAJE INTERACTIVA
      // Los datos se inyectan desde Astro como JSON seguro.
      const suiteProjects = document.getElementById("suite-data");
      const clips = [...document.querySelectorAll<HTMLButtonElement>(".timeline-clip")];
      const screen = document.getElementById("suite-screen");
      const screenImage = document.getElementById("suite-image") as HTMLImageElement | null;
      const playhead = document.getElementById("playhead");
      let selectedClip = 0;
      let suitePlayer: HTMLIFrameElement | null = null;
      const projects = suiteProjects ? JSON.parse(suiteProjects.textContent || "[]") as Array<{
        id: string; titulo: string; descripcion: string; categoria: string; habilidades: string[]; miniatura?: string; vertical: boolean;
      }> : [];

      function selectClip(index: number) {
        const project = projects[index];
        if (!project || !screen) return;
        selectedClip = index;
        suitePlayer?.remove();
        suitePlayer = null;
        screenImage?.classList.remove("hidden");
        screen.querySelector(".suite-screen-overlay")?.classList.remove("hidden");
        const title = document.getElementById("suite-info-title");
        const desc = document.getElementById("suite-info-desc");
        const displayTitle = document.getElementById("suite-project-title");
        const count = document.getElementById("suite-index");
        const fmt = document.getElementById("suite-format");
        const time = document.getElementById("suite-timecode");
        const tags = document.getElementById("suite-info-tags");
        const link = document.getElementById("suite-yt-link") as HTMLAnchorElement | null;
        if (title) title.textContent = project.titulo;
        if (desc) desc.textContent = project.descripcion;
        if (displayTitle) displayTitle.textContent = project.titulo;
        if (count) count.textContent = String(index + 1).padStart(2, "0");
        if (fmt) fmt.textContent = project.vertical ? "9:16 · SHORT" : "16:9 · VIDEO";
        if (time) time.textContent = `00:00:${String(index * 12).padStart(2, "0")}:00`;
        if (link) link.href = project.vertical
          ? `https://www.youtube.com/shorts/${project.id}`
          : `https://www.youtube.com/watch?v=${project.id}`;
        if (tags) {
          tags.replaceChildren(...project.habilidades.map((value) => {
            const span = document.createElement("span");
            span.textContent = value;
            return span;
          }));
        }
        if (screenImage) {
          screenImage.src = project.miniatura || `https://i.ytimg.com/vi/${project.id}/maxresdefault.jpg`;
          screenImage.alt = `Vista previa de ${project.titulo}`;
          screenImage.classList.toggle("portrait-preview", project.vertical);
        }
        clips.forEach((clip, i) => {
          clip.classList.toggle("active", i === index);
          clip.setAttribute("aria-pressed", i === index ? "true" : "false");
        });
        document.querySelectorAll("[data-audio-index]").forEach((clip) => {
          clip.classList.toggle("active", Number((clip as HTMLElement).dataset.audioIndex) === index);
        });
        if (playhead) {
          playhead.style.left = `${(index / Math.max(projects.length, 1)) * 100}%`;
        }
      }
      clips.forEach((clip, i) => clip.addEventListener("click", () => selectClip(i)));
      screenImage?.addEventListener("error", () => {
        const project = projects[selectedClip];
        if (!project || !screenImage || project.miniatura) return;
        if (screenImage.src.includes("maxresdefault")) {
          screenImage.src = `https://i.ytimg.com/vi/${project.id}/hqdefault.jpg`;
        }
      });
      document.getElementById("suite-play")?.addEventListener("click", () => {
        const project = projects[selectedClip];
        if (!project || !screen) return;
        // También detenemos cualquier video iniciado en la galería.
        document.querySelectorAll<HTMLElement>(".video-container.is-playing").forEach((container) => {
          const iframe = container.querySelector("iframe");
          iframe?.remove();
          window.dispatchEvent(new CustomEvent("portfolio-reset-cover", { detail: container }));
        });
        const iframe = document.createElement("iframe");
        iframe.src = `https://www.youtube-nocookie.com/embed/${encodeURIComponent(project.id)}?autoplay=1&rel=0`;
        iframe.title = `Reproduciendo: ${project.titulo}`;
        iframe.allow = "accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture; web-share";
        iframe.allowFullscreen = true;
        iframe.className = "suite-iframe";
        suitePlayer = iframe;
        screen.appendChild(iframe);
        screen.querySelector(".suite-screen-overlay")?.classList.add("hidden");
        screenImage?.classList.add("hidden");
      });
      selectClip(0);

      // Conservamos la miniatura original de cada tarjeta para recuperarla
      // cuando se reproduce un video diferente.
      const containers = [...document.querySelectorAll<HTMLElement>(".video-container")];
      const originalCovers = new Map<HTMLElement, HTMLButtonElement>();

      for (const container of containers) {
        const originalButton = container.querySelector<HTMLButtonElement>(".video-cover");
        if (originalButton) originalCovers.set(container, originalButton);
      }

      window.addEventListener("portfolio-reset-cover", (event) => {
        const container = (event as CustomEvent<HTMLElement>).detail;
        const cover = originalCovers.get(container);
        if (cover) container.replaceChildren(cover);
        container.classList.remove("is-playing");
      });

      function activateVideo(container: HTMLElement) {
        suitePlayer?.remove();
        suitePlayer = null;
        screenImage?.classList.remove("hidden");
        screen?.querySelector(".suite-screen-overlay")?.classList.remove("hidden");
        const id = container.dataset.youtubeId;
        if (!id) return;

        for (const other of containers) {
          if (other === container || !other.classList.contains("is-playing")) continue;
          const cover = originalCovers.get(other);
          if (cover) other.replaceChildren(cover);
          other.classList.remove("is-playing");
        }

        const iframe = document.createElement("iframe");
        iframe.src = `https://www.youtube-nocookie.com/embed/${encodeURIComponent(id)}?autoplay=1&rel=0`;
        iframe.title = originalCovers.get(container)?.getAttribute("aria-label") || "Video de YouTube";
        iframe.allow = "accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture; web-share";
        iframe.allowFullscreen = true;
        iframe.className = "youtube-player";
        container.replaceChildren(iframe);
        container.classList.add("is-playing");
      }

      // Delegación de eventos: también sirve al restaurar una miniatura.
      document.querySelector(".projects")?.addEventListener("click", (event) => {
        if (!(event.target instanceof Element)) return;
        const button = event.target.closest(".video-cover");
        const container = button?.closest<HTMLElement>(".video-container");
        if (container) activateVideo(container);
      });

      // Galerías deslizables: desplazamiento táctil, ratón, flechas y teclado.
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
      for (const type of ["long", "short"]) {
        const viewport = document.getElementById(`${type}-carousel`);
        if (!viewport) continue;
        const cards = [...viewport.querySelectorAll<HTMLElement>(".video-card")];
        const previous = document.querySelector<HTMLButtonElement>(`[data-carousel="${type}"][data-direction="-1"]`);
        const next = document.querySelector<HTMLButtonElement>(`[data-carousel="${type}"][data-direction="1"]`);

        function updateArrows() {
          const end = viewport!.scrollWidth - viewport!.clientWidth;
          if (previous) previous.disabled = viewport!.scrollLeft <= 3;
          if (next) next.disabled = viewport!.scrollLeft >= end - 3;
        }

        function move(direction: number) {
          const current = viewport!.scrollLeft;
          const destinations = cards.map(card => card.offsetLeft - cards[0].offsetLeft);
          const target = direction > 0
            ? destinations.find(x => x > current + 5) ?? viewport!.scrollWidth
            : [...destinations].reverse().find(x => x < current - 5) ?? 0;
          viewport!.scrollTo({ left: target, behavior: reduceMotion.matches ? "instant" : "smooth" });
        }

        previous?.addEventListener("click", () => move(-1));
        next?.addEventListener("click", () => move(1));
        viewport.addEventListener("keydown", (event) => {
          if (event.target !== viewport) return;
          if (event.key === "ArrowRight" || event.key === "ArrowLeft") {
            event.preventDefault();
            move(event.key === "ArrowRight" ? 1 : -1);
          }
        });
        viewport.addEventListener("scroll", updateArrows, { passive: true });
        window.addEventListener("resize", updateArrows);
        updateArrows();
      }
    </script>
  </body>
</html>

