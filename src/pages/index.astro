---
type Proyecto = {
  id: string;
  titulo: string;
  categoria: string;
  descripcion: string;
  habilidades: string[];
  formato: "largo" | "short";
  orden: number;
  miniatura?: string;
};

// Permite pegar URLs completas o el ID sin modificar los proyectos existentes.
function obtenerIdYouTube(valor: string): string {
  const texto = String(valor ?? '').trim();
  if (/^[a-zA-Z0-9_-]{11}$/.test(texto)) return texto;
  try {
    const url = new URL(texto);
    const host = url.hostname.toLowerCase().replace(/^www\./, '').replace(/^m\./, '');
    let candidato = '';
    if (host === 'youtu.be') candidato = url.pathname.split('/')[1] ?? '';
    else if (['youtube.com', 'youtube-nocookie.com', 'music.youtube.com'].includes(host)) {
      const partes = url.pathname.split('/').filter(Boolean);
      if (partes[0] === 'watch') candidato = url.searchParams.get('v') ?? '';
      else if (['shorts', 'embed', 'live'].includes(partes[0])) candidato = partes[1] ?? '';
    }
    if (/^[a-zA-Z0-9_-]{11}$/.test(candidato)) return candidato;
  } catch { /* Un enlace incompleto no es válido. */ }
  throw new Error(`Enlace o ID de YouTube inválido: ${texto}`);
}

// Pages CMS administra los JSON de esta carpeta. Astro los importa en cada build.
const modulos = import.meta.glob('../content/proyectos/*.json', { eager: true, import: 'default' });
const base = import.meta.env.BASE_URL;
const proyectos: Proyecto[] = Object.values(modulos).map((raw) => {
  const p = raw as Proyecto;
  const imagen = p.miniatura?.trim();
  const miniatura = imagen
    ? (imagen.startsWith('/') && !imagen.startsWith(base) ? `${base}${imagen.slice(1)}` : imagen)
    : undefined;
  return { ...p, id: obtenerIdYouTube(p.id), habilidades: p.habilidades ?? [], miniatura };
}).sort((a, b) => (a.orden ?? 999) - (b.orden ?? 999));
const videosLargos = proyectos.filter((p) => p.formato === 'largo');
const shorts = proyectos.filter((p) => p.formato === 'short');

const proyectosMontaje = [...videosLargos, ...shorts];
const total = proyectosMontaje.length;
const suiteJSON = JSON.stringify(proyectosMontaje.map((p, i) => ({ ...p, vertical: i >= videosLargos.length }))).replace(/</g, "\\u003c");
